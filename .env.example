# Ambiente & Servidor HTTP
NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
API_PROBLEM_BASE_URI=https://api.sicam.local/problems
FRONTEND_ORIGIN=http://localhost:5173
ENABLE_OPENAPI_ROUTE=true

# Banco de Dados PostgreSQL 16 + PostGIS 3.4 (Segregação Least Privilege)
DATABASE_MIGRATOR_URL=postgresql://app_migrator:migrator_dev_secret@localhost:5432/sicam
DATABASE_URL=postgresql://app_runtime:runtime_dev_secret@localhost:5432/sicam

# Redis 7 (BullMQ, SSE Pub/Sub, Rate Limit e Idempotency-Key)
REDIS_URL=redis://localhost:6379

# Armazenamento S3 Auto-Hospedado (ADR-09 — 100% Privado)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=sicam_s3_admin
S3_SECRET_ACCESS_KEY=sicam_s3_dev_secret_key
S3_BUCKET=sicam-artifacts
S3_FORCE_PATH_STYLE=true

# Segurança & Autenticação Assimétrica EdDSA (Ed25519 PEM em base64 opcional; em dev gera par efêmero se vazio)
JWT_ED25519_PRIVATE_KEY_B64=
JWT_ED25519_PUBLIC_KEY_B64=
JWT_ISSUER=sicam-api
JWT_AUDIENCE=sicam-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# Limites Operacionais Configuráveis (ADR-13 / RN-06)
MIN_AOI_AREA_HA=0.5
MAX_AOI_AREA_HA=50000
MAX_AOI_VERTICES=500
MAX_ACTIVE_RUNS_PER_USER=2
ENFORCE_IMPORTED_UF_COVERAGE=true
GEO_MAX_PIXELS_GUARD=8000000
ENGINE_VERSION=1.0.0
