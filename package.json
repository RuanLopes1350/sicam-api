{
  "name": "sicam-api",
  "version": "1.0.0",
  "description": "API para o SICAM - Sistema de Carta-Imagem e Análise Multitemporal",
  "author": "Ruan Lopes",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:migrate": "tsx src/config/db/migrate.ts",
    "db:seed": "tsx src/seeds/index.ts",
    "ibge:import": "tsx src/scripts/ibgeImport.cli.ts",
    "openapi:export": "tsx src/docs/exportOpenApi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@node-rs/argon2": "^2.0.2",
    "bullmq": "^5.40.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "geotiff": "^3.0.5",
    "ioredis": "^5.5.0",
    "jose": "^5.9.6",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "proj4": "^2.23.0",
    "sharp": "^0.35.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/proj4": "^2.19.0",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.30.4",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
